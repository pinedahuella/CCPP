--- !u!114 &1008840964
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1008840959}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2575ae5c34a678540b7d076e6c539a76, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogoInicial:
    lineas:
    - texto: "Oh no... deber\xEDa levantarme..."
      imagen: {fileID: 6028500041128602635, guid: 7a3cb699bb727a14e8c89906876fd482, type: 3}
      esIzquierda: 0
    - texto: "\xBFQu\xE9 d\xEDa es hoy?"
      imagen: {fileID: 6028500041128602635, guid: 7a3cb699bb727a14e8c89906876fd482, type: 3}
      esIzquierda: 0
    - texto: "\xA1Es domingo!"
      imagen: {fileID: 6028500041128602635, guid: 7a3cb699bb727a14e8c89906876fd482, type: 3}
      esIzquierda: 0
    - texto: 'Debo mover mis piernas para levantarme

'
      imagen: {fileID: 6028500041128602635, guid: 7a3cb699bb727a14e8c89906876fd482, type: 3}
      esIzquierda: 0
    - texto: "Deber\xEDa ponerlas rectas\n"
      imagen: {fileID: 6028500041128602635, guid: 7a3cb699bb727a14e8c89906876fd482, type: 3}
      esIzquierda: 0
  dialogoFallo:
    lineas:
    - texto: "De esa forma no podr\xE9 levantarme..."
      imagen: {fileID: 6028500041128602635, guid: 7a3cb699bb727a14e8c89906876fd482, type: 3}
      esIzquierda: 0
  dialogoExito:
    lineas:
    - texto: "\xA1Listo, pude levantarme!"
      imagen: {fileID: 6028500041128602635, guid: 7a3cb699bb727a14e8c89906876fd482, type: 3}
      esIzquierda: 0
    - texto: "Deber\xEDa salir"
      imagen: {fileID: 6028500041128602635, guid: 7a3cb699bb727a14e8c89906876fd482, type: 3}
      esIzquierda: 0
  pensamientoJugador: {fileID: 1784196175}
