      imagen: {fileID: -1558624224928489165, guid: c2737135f710935479183f7d42749469, type: 3}
      esIzquierda: 0
    - texto: "\xA1Cu\xE1nto tiempo!"
      imagen: {fileID: 6028500041128602635, guid: 7a3cb699bb727a14e8c89906876fd482, type: 3}
      esIzquierda: 1
    - texto: "\xBFC\xF3mo est\xE1s?"
      imagen: {fileID: 6028500041128602635, guid: 7a3cb699bb727a14e8c89906876fd482, type: 3}
      esIzquierda: 1
    - texto: "\xBFRecuerdas nuestro saludo secreto con la mano?\n"
      imagen: {fileID: -1558624224928489165, guid: c2737135f710935479183f7d42749469, type: 3}
      esIzquierda: 0
    - texto: "Creo que deber\xEDa saludar a mi amigo...\n\n"
      imagen: {fileID: 6028500041128602635, guid: 7a3cb699bb727a14e8c89906876fd482, type: 3}
      esIzquierda: 1
  dialogoExito:
    lineas:
    - texto: "\xA1Bravo! Si que recuerdas \xBFEh?\n"
      imagen: {fileID: -1558624224928489165, guid: c2737135f710935479183f7d42749469, type: 3}
      esIzquierda: 0
  dialogoFallo:
    lineas:
    - texto: 'Parece que no recuerdas del todo...

'
      imagen: {fileID: -1558624224928489165, guid: c2737135f710935479183f7d42749469, type: 3}
      esIzquierda: 0
    - texto: 'Intentemos de nuevo

'
      imagen: {fileID: -1558624224928489165, guid: c2737135f710935479183f7d42749469, type: 3}
      esIzquierda: 0
  spritesDesactivar:
  - {fileID: 1741769518}
  - {fileID: 123320270}
  spritesActivar:
