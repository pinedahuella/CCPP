  visualJugadorReal: {fileID: 1741769516}
  puntoResetJugador: {fileID: 1395874496}
  transformJugador: {fileID: 2135234600}
  vidaUI: {fileID: 770962174}
  panelTitulo: {fileID: 2108087860}
  textoTitulo: {fileID: 580733511}
  pensamientoJugador: {fileID: 1784196175}
  indicadorSpace: {fileID: 967327478}
  objetoGanar: {fileID: 0}
  escenas:
  - nombreEscena: primera scena
    mostrarTitulo: 1
    textoTitulo: RITOS INICIALES
    dialogoInicial:
      lineas:
      - texto: "Pensando para s\xED mismo: creo que todos se pararon "
        imagen: {fileID: 6028500041128602635, guid: 7a3cb699bb727a14e8c89906876fd482, type: 3}
        esIzquierda: 0
    dialogoExito:
      lineas:
      - texto: "Pensando para s\xED mismo: Creo que fue una muy buena idea, asi se
          comienza siempre"
        imagen: {fileID: 6028500041128602635, guid: 7a3cb699bb727a14e8c89906876fd482, type: 3}
        esIzquierda: 0
    dialogoFallo:
      lineas:
      - texto: "Pensando para s\xED mismo: Creo que debi pararme como todos los dem\xE1s"
        imagen: {fileID: 6028500041128602635, guid: 7a3cb699bb727a14e8c89906876fd482, type: 3}
        esIzquierda: 0
    tipoAccion: 0
    valorEsperado: 1
    musicaOpcional: {fileID: 0}
    animacionSacerdote: CaminandoE
    puntoDestino: {fileID: 1666989174}
    velocidadSacerdote: 2
    activar:
    - {fileID: 111453608}
    - {fileID: 319266054}
    - {fileID: 111724890}
    desactivar:
    - {fileID: 620883537}
    visualesJugador: []
  - nombreEscena: 2
    mostrarTitulo: 0
    textoTitulo: 
    dialogoInicial:
      lineas:
      - texto: "Susurrando en voz muy baja: Cuando inicia la misa, hacemos la se\xF1al
          de la cruz"
        imagen: {fileID: -1833472316, guid: 073d6012b9890584d9db516dca5ef474, type: 3}
        esIzquierda: 0
      - texto: "En el nombre del Padre, y del Hijo, y del Esp\xEDritu Santo"
        imagen: {fileID: 533397444, guid: c0e25fe99e357ca47b3467c50b1771cb, type: 3}
        esIzquierda: 0
    dialogoExito:
      lineas:
      - texto: "Am\xE9n"
        imagen: {fileID: 0}
        esIzquierda: 0
      - texto: "Susurrando en voz muy baja: As\xED comenzamos la misa, reconociendo
          a Dios"
        imagen: {fileID: -1833472316, guid: 073d6012b9890584d9db516dca5ef474, type: 3}
        esIzquierda: 0
    dialogoFallo:
      lineas:
      - texto: "Susurrando en voz muy baja: Debes hacer la se\xF1al de la cruz al
          iniciar"
        imagen: {fileID: -1833472316, guid: 073d6012b9890584d9db516dca5ef474, type: 3}
        esIzquierda: 0
    tipoAccion: 1
    valorEsperado: 2
    musicaOpcional: {fileID: 0}
    animacionSacerdote: SenalCruz
    puntoDestino: {fileID: 1666989174}
    velocidadSacerdote: 0
    activar:
    - {fileID: 2098763017}
    desactivar:
    - {fileID: 319266054}
    visualesJugador: []
  - nombreEscena: 3
    mostrarTitulo: 0
    textoTitulo: 
    dialogoInicial:
      lineas:
      - texto: 'Susurrando en voz muy baja: Ahora respondemos al sacerdote'
        imagen: {fileID: -1833472316, guid: 073d6012b9890584d9db516dca5ef474, type: 3}
        esIzquierda: 0
      - texto: "El Se\xF1or est\xE9 con ustedes"
        imagen: {fileID: 2061979975, guid: c0e25fe99e357ca47b3467c50b1771cb, type: 3}
        esIzquierda: 0
    dialogoExito:
      lineas:
      - texto: 'Susurrando en voz muy baja: Es la respuesta tradicional de la misa'
        imagen: {fileID: -1833472316, guid: 073d6012b9890584d9db516dca5ef474, type: 3}
        esIzquierda: 0
    dialogoFallo:
      lineas:
      - texto: "Susurrando en voz muy baja: La respuesta correcta es \u201CY con
          tu esp\xEDritu\u201D"
        imagen: {fileID: -1833472316, guid: 073d6012b9890584d9db516dca5ef474, type: 3}
        esIzquierda: 0
    tipoAccion: 4
    valorEsperado: 1
    musicaOpcional: {fileID: 0}
    animacionSacerdote: SenalCruz
    puntoDestino: {fileID: 1666989174}
    velocidadSacerdote: 0
    activar:
    - {fileID: 1901264826}
    desactivar: []
    visualesJugador: []
