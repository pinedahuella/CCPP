  pensamientoJugador: {fileID: 1784196175}
  cuadroNegro: {fileID: 1943473399}
  habilidadesJugador: {fileID: 2135234601}
  habilidadADesbloquear: 0
  uiNuevaHabilidad: {fileID: 0}
  tipoAccion: 0
  respuestaEsperada: 2
  dialogoInicial:
    lineas:
    - texto: A veces descansar es necesario...
      imagen: {fileID: 1894381079, guid: 676084f6b6693a44bb360ae1cb6297dc, type: 3}
      esIzquierda: 0
    - texto: Es bueno para relajar las piernas
      imagen: {fileID: 1894381079, guid: 676084f6b6693a44bb360ae1cb6297dc, type: 3}
      esIzquierda: 0
    - texto: "Deber\xEDas intentarlo"
      imagen: {fileID: 1894381079, guid: 676084f6b6693a44bb360ae1cb6297dc, type: 3}
      esIzquierda: 0
    - texto: "Tiene raz\xF3n, sentarme un poco no me har\xE1 da\xF1o..."
      imagen: {fileID: -5594571088291617305, guid: 026ab7bfb7d173743a2275cee1db0e8b, type: 3}
      esIzquierda: 1
  dialogoExito:
    lineas:
    - texto: "Ahora s\xE9 que sentarme es importante de vez en cuando"
      imagen: {fileID: 1001673385, guid: 026ab7bfb7d173743a2275cee1db0e8b, type: 3}
      esIzquierda: 1
  dialogoFallo:
    lineas:
    - texto: "No creo que sentarte as\xED sea muy c\xF3modo...\nInt\xE9ntalo nuevamente..."
      imagen: {fileID: 1894381079, guid: 676084f6b6693a44bb360ae1cb6297dc, type: 3}
      esIzquierda: 0
  spritesDesactivar:
  - {fileID: 1741769518}
  spritesActivar:
