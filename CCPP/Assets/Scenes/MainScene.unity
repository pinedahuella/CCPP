  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1f640f0b54c8d2947a79e092a4124b89, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  indicadorSpace: {fileID: 25237309}
  pensamientoJugador: {fileID: 1784196175}
  cuadroNegro: {fileID: 1943473399}
  habilidadesJugador: {fileID: 2135234601}
  habilidadADesbloquear: 4
  uiNuevaHabilidad: {fileID: 0}
  tipoAccion: 1
  respuestaEsperada: 2
  dialogoInicial:
    lineas:
    - texto: "Siempre que paso por ac\xE1 la gente hace algo...\nAlgo parecido a
        una cruz..."
      imagen: {fileID: -5594571088291617305, guid: 026ab7bfb7d173743a2275cee1db0e8b, type: 3}
      esIzquierda: 1
    - texto: " Disculpe se\xF1or, \xBFusted sabe que se hace cuando paso por algo
        sagrado?"
      imagen: {fileID: -5594571088291617305, guid: 026ab7bfb7d173743a2275cee1db0e8b, type: 3}
      esIzquierda: 1
    - texto: " Deber\xEDas hacer una cruz siempre que pases frente a algo sagrado"
      imagen: {fileID: 1821273375, guid: 23fade9c1b1f95140b64ac1d6bcb8183, type: 3}
      esIzquierda: 0
  dialogoExito:
    lineas:
    - texto: " \xA1As\xED se hace!\n"
      imagen: {fileID: 1821273375, guid: 23fade9c1b1f95140b64ac1d6bcb8183, type: 3}
      esIzquierda: 0
    - texto: "Genial, aprend\xED a persinarme"
      imagen: {fileID: -5594571088291617305, guid: 026ab7bfb7d173743a2275cee1db0e8b, type: 3}
      esIzquierda: 1
  dialogoFallo:
    lineas:
    - texto: 'Creo que esa no es una cruz...

        Intenta de nuevo'
      imagen: {fileID: 1821273375, guid: 23fade9c1b1f95140b64ac1d6bcb8183, type: 3}
      esIzquierda: 0
  spritesDesactivar:
  - {fileID: 1741769518}
  - {fileID: 1324467918}
  spritesActivar:
  - {fileID: 795109730}
  - {fileID: 1348004293}
  velocidadCuadro: 2
  tiempoAntesDeSwap: 0.3
  tiempoEntreSwapYSubida: 0.5
  tiempoAntesSegundoBajada: 0.8
  tiempoEntreSwapFinalYSubida: 0.5
