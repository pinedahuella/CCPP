  m_Script: {fileID: 11500000, guid: 1f640f0b54c8d2947a79e092a4124b89, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  indicadorSpace: {fileID: 1725964606}
  pensamientoJugador: {fileID: 1784196175}
  cuadroNegro: {fileID: 1943473399}
  habilidadesJugador: {fileID: 2135234601}
  habilidadADesbloquear: 2
  uiNuevaHabilidad: {fileID: 420098879}
  tipoAccion: 3
  respuestaEsperada: 1
  dialogoInicial:
    lineas:
    - texto: "Pap\xE1, si te hubiera escuchado no me hubiera lastimado..."
      imagen: {fileID: 770624724620159046, guid: abc372bb9fc28cc41b1f807ab0362921, type: 3}
      esIzquierda: 0
    - texto: "Por eso debes aprender a prestar atenci\xF3n, hijo"
      imagen: {fileID: 4761308458838808161, guid: 98fb4da51a49b184da85a201094d8b04, type: 3}
      esIzquierda: 0
    - texto: "\xBFY c\xF3mo se hace eso?"
      imagen: {fileID: 770624724620159046, guid: abc372bb9fc28cc41b1f807ab0362921, type: 3}
      esIzquierda: 0
    - texto: 'Para ello, debes practicarlo

'
      imagen: {fileID: 4761308458838808161, guid: 98fb4da51a49b184da85a201094d8b04, type: 3}
      esIzquierda: 0
    - texto: "Deber\xEDa aprender a prestar atenci\xF3n cuando me hablan"
      imagen: {fileID: -5594571088291617305, guid: 026ab7bfb7d173743a2275cee1db0e8b, type: 3}
      esIzquierda: 1
  dialogoExito:
    lineas:
    - texto: "\xA1Genial, aprend\xED a prestar atenci\xF3n!"
      imagen: {fileID: -5594571088291617305, guid: 026ab7bfb7d173743a2275cee1db0e8b, type: 3}
      esIzquierda: 1
  dialogoFallo:
    lineas:
    - texto: "Creo que no entend\xED de lo que estaban hablando ese padre y su hijo...\nDeber\xEDa
        o\xEDrlos nuevamente..."
      imagen: {fileID: -5594571088291617305, guid: 026ab7bfb7d173743a2275cee1db0e8b, type: 3}
      esIzquierda: 1
