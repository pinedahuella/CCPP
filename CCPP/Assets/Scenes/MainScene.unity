  habilidadADesbloquear: 3
  uiNuevaHabilidad: {fileID: 0}
  tipoAccion: 4
  respuestaEsperada: 2
  dialogoInicial:
    lineas:
    - texto: "\xA1Me encanta cantar!"
      imagen: {fileID: -1664019660, guid: 8e00340a89e1ceb47a854829ac4f2e01, type: 3}
      esIzquierda: 0
    - texto: "\xBFPor qu\xE9 no cantas conmigo?"
      imagen: {fileID: -1664019660, guid: 8e00340a89e1ceb47a854829ac4f2e01, type: 3}
      esIzquierda: 0
    - texto: "Deber\xEDa acompa\xF1arlo cantando"
      imagen: {fileID: -5594571088291617305, guid: 026ab7bfb7d173743a2275cee1db0e8b, type: 3}
      esIzquierda: 1
  dialogoExito:
    lineas:
    - texto: "\xA1Genial, aprend\xED a cantar!"
      imagen: {fileID: -5594571088291617305, guid: 026ab7bfb7d173743a2275cee1db0e8b, type: 3}
      esIzquierda: 1
  dialogoFallo:
    lineas:
    - texto: "Debes practicar m\xE1s tu voz\nVamos, vuelve a intentarlo"
      imagen: {fileID: -1664019660, guid: 8e00340a89e1ceb47a854829ac4f2e01, type: 3}
      esIzquierda: 1
