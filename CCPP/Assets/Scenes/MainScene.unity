  m_Name: 
  m_EditorClassIdentifier: 
  indicadorSpace: {fileID: 288854992}
  pensamientoJugador: {fileID: 1784196175}
  cuadroNegro: {fileID: 1943473399}
  habilidadesJugador: {fileID: 2135234601}
  habilidadADesbloquear: 4
  uiNuevaHabilidad: {fileID: 0}
  tipoAccion: 0
  respuestaEsperada: 3
  dialogoInicial:
    lineas:
    - texto: '!Mira mi gato!'
      imagen: {fileID: 1464126088, guid: 073d6012b9890584d9db516dca5ef474, type: 3}
      esIzquierda: 0
    - texto: "\xBFPuedo tocarlo?"
      imagen: {fileID: -5594571088291617305, guid: 026ab7bfb7d173743a2275cee1db0e8b, type: 3}
      esIzquierda: 1
    - texto: '!Claro! No muerde'
      imagen: {fileID: 1464126088, guid: 073d6012b9890584d9db516dca5ef474, type: 3}
      esIzquierda: 0
    - texto: "Deber\xEDa arrodillarme para poder acariciarlo"
      imagen: {fileID: -5594571088291617305, guid: 026ab7bfb7d173743a2275cee1db0e8b, type: 3}
      esIzquierda: 1
  dialogoExito:
    lineas:
    - texto: 'Parece que le agradaste mucho

'
      imagen: {fileID: 1464126088, guid: 073d6012b9890584d9db516dca5ef474, type: 3}
      esIzquierda: 0
    - texto: "Deber\xEDas jugar m\xE1s a menudo con \xE9l\n"
      imagen: {fileID: 1464126088, guid: 073d6012b9890584d9db516dca5ef474, type: 3}
      esIzquierda: 0
    - texto: "Deber\xEDa recordarme como arrodillarme, puede ser importante m\xE1s
        adelante"
      imagen: {fileID: -5594571088291617305, guid: 026ab7bfb7d173743a2275cee1db0e8b, type: 3}
      esIzquierda: 1
  dialogoFallo:
    lineas:
    - texto: "Creo que as\xED no podr\xE9 acariciar al gatito...\nDeber\xEDa intentarlo
        otra vez..."
      imagen: {fileID: -5594571088291617305, guid: 026ab7bfb7d173743a2275cee1db0e8b, type: 3}
      esIzquierda: 1
  spritesDesactivar:
  - {fileID: 1741769518}
  spritesActivar:
  - {fileID: 1476461674}
  velocidadCuadro: 2
  tiempoAntesDeSwap: 0.3
  tiempoEntreSwapYSubida: 0.5
