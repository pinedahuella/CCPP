  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1f640f0b54c8d2947a79e092a4124b89, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  indicadorSpace: {fileID: 1351552818}
  pensamientoJugador: {fileID: 1784196175}
  cuadroNegro: {fileID: 1943473399}
  habilidadesJugador: {fileID: 2135234601}
  habilidadADesbloquear: 3
  uiNuevaHabilidad: {fileID: 531609787}
  tipoAccion: 4
  respuestaEsperada: 1
  dialogoInicial:
    lineas:
    - texto: " \xA1Hola Amigo! \xBFpuedes decirme como se llama la estrella que ilumina
        el sistema solar?"
      imagen: {fileID: -3486385279671290158, guid: 126626240a3b0f648a5c7ecb7f021462, type: 3}
      esIzquierda: 0
    - texto: "Oh no.. deber\xEDa responder, para ello utilizar\xE9 mi boca..."
      imagen: {fileID: -5594571088291617305, guid: 026ab7bfb7d173743a2275cee1db0e8b, type: 3}
      esIzquierda: 1
    - texto: "Recuerda que si no te acuerdas, de seguro la respuesta est\xE1 en tu
        mente solo b\xFAscala"
      imagen: {fileID: -3486385279671290158, guid: 126626240a3b0f648a5c7ecb7f021462, type: 3}
      esIzquierda: 0
  dialogoExito:
    lineas:
    - texto: "\xA1Genial! Tu si que sabes de astronom\xEDa, deber\xEDas ense\xF1arme
        un d\xEDa\nRecuerda que si no sabes la respuesta, puedes intentar pensar
        mucho"
      imagen: {fileID: -3486385279671290158, guid: 126626240a3b0f648a5c7ecb7f021462, type: 3}
      esIzquierda: 0
  dialogoFallo:
    lineas:
    - texto: "Creo que no se llama as\xED...\nIntenta de nuevo..."
      imagen: {fileID: -3486385279671290158, guid: 126626240a3b0f648a5c7ecb7f021462, type: 3}
      esIzquierda: 0
