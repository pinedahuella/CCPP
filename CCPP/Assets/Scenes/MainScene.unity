  m_Script: {fileID: 11500000, guid: 1f640f0b54c8d2947a79e092a4124b89, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  indicadorSpace: {fileID: 874142467}
  pensamientoJugador: {fileID: 1784196175}
  cuadroNegro: {fileID: 1943473399}
  habilidadesJugador: {fileID: 2135234601}
  habilidadADesbloquear: 1
  uiNuevaHabilidad: {fileID: 1842960629}
  tipoAccion: 2
  respuestaEsperada: 1
  dialogoInicial:
    lineas:
    - texto: "Sabes... discut\xED con mi esposa hace rato.."
      imagen: {fileID: 2067704713, guid: 23fade9c1b1f95140b64ac1d6bcb8183, type: 3}
      esIzquierda: 0
    - texto: "Creo que dije cosas que no deb\xED..."
      imagen: {fileID: 2067704713, guid: 23fade9c1b1f95140b64ac1d6bcb8183, type: 3}
      esIzquierda: 0
    - texto: "Pero... ahora me siento arrepentido, deber\xEDa disculparme"
      imagen: {fileID: 2067704713, guid: 23fade9c1b1f95140b64ac1d6bcb8183, type: 3}
      esIzquierda: 0
    - texto: Todos debemos arrepentirnos de nuestros pecados
      imagen: {fileID: 2067704713, guid: 23fade9c1b1f95140b64ac1d6bcb8183, type: 3}
      esIzquierda: 0
    - texto: "Deber\xEDa arrepentirme por si da\xF1e a alguien..."
      imagen: {fileID: -5594571088291617305, guid: 026ab7bfb7d173743a2275cee1db0e8b, type: 3}
      esIzquierda: 1
  dialogoExito:
    lineas:
    - texto: "Genial, lograste arrepentirte, eso te ayudar\xE1 mucho"
      imagen: {fileID: -5594571088291617305, guid: 026ab7bfb7d173743a2275cee1db0e8b, type: 3}
      esIzquierda: 1
  dialogoFallo:
    lineas:
    - texto: "Creo que no te arrepentiste de verdad...\nInt\xE9ntalo de nuevo"
      imagen: {fileID: 2067704713, guid: 23fade9c1b1f95140b64ac1d6bcb8183, type: 3}
      esIzquierda: 0
  spritesDesactivar:
  - {fileID: 1741769518}
  spritesActivar:
  - {fileID: 2038946711}
